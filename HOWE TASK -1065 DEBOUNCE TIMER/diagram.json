{
  "version": 1,
  "author": "Ahmar",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -90, "left": 150, "attrs": { "color": "green" } },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -20,
      "left": 190,
      "rotate": 90,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 120,
      "left": 190,
      "attrs": { "color": "green" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:13", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led1:A", "green", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:32", "btn1:1.l", "blue", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.3", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}